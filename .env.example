# Clerk (required - https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=Your_value_goes_here
CLERK_SECRET_KEY=Your_value_goes_here

# Sanity (required - https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=Your_value_goes_here
NEXT_PUBLIC_SANITY_DATASET=Your_value_goes_here
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-13
NEXT_PUBLIC_SANITY_ORG_ID=Your_value_goes_here
SANITY_API_WRITE_TOKEN=Your_value_goes_here

# Groq (required for AI shopping assistant - https://console.groq.com/keys)
GROQ_API_KEY=Your_value_goes_here
# Optional: override the model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=Your_value_goes_here

# Stripe (optional - only needed for checkout/payments - https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=Your_value_goes_here
STRIPE_WEBHOOK_SECRET=Your_value_goes_here

# Optional - public base URL used in Stripe redirect URLs (defaults to localhost:3000)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional - Vercel AI Gateway (only used by the /api/admin/insights route)
AI_GATEWAY_API_KEY=Your_value_goes_here
